# ---- macOS ----
.DS_Store

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# ---- Terraform ----
# State and crash logs — can contain secrets in plaintext (passwords, API keys)
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Provider plugin cache — huge and regenerable
.terraform/
.terraform.tfstate.lock.info

# Local .tfvars (in case you ever use them) — typically hold secrets
*.tfvars
*.tfvars.json
!example.tfvars   # if you ever ship a template, exclude that exclude

# Keep the lock file — Terraform best practice
# .terraform.lock.hcl is intentionally NOT ignored

# ---- Build artifacts ----
# Lambda zips are regenerated by archive_file every apply
Terraform/*.zip

# Pip-installed dependency layer (hundreds of MB, regenerated on apply)
Resources/lambda_libraries/

# ---- Secrets / env files ----
.env
.env.*
*.pem
*.key

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
*.swo
